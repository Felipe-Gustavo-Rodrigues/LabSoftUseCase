@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Novo Departamento";
}

<h1 class="mb-4">Cadastrar Novo Departamento</h1>


<div class="row">
    <div class="col-md-6">

        <form action="/Departamentoes/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="Nome" class="form-label font-weight-bold">Descricao</label>
                <input type="text" id="Descricao" name="Descricao" class="form-control" placeholder="Digite a descriçaõ do Departamento" required />
            </div>

            <div class="mb-3">
                <label for="Ativo" class="form-label">Status do Departamento</label>
                <select id="Ativo" name="Ativo" class="form-select" required>
                    <option value="true">Ativo</option>
                    <option value="false">Inativo</option>
                </select>
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar Departamento</button>
                <a href="/Departamentoes/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>

