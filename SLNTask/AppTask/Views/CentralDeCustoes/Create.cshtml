@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Nova Central De Custo";
}

<h1 class="mb-4">Cadastrar Nova Central De Custo</h1>

<div class="row">
    <div class="col-md-6">
        <form action="/CentralDeCustoes/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="NomeCentral" class="form-label font-weight-bold">NomeCentral</label>
                <input type="text" id="NomeCentral" name="NomeCentral" class="form-control" placeholder="Digite a nome da Central De Custo" required />
            </div>


            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar Central De Custo</button>
                <a href="/CentralDeCustoes/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>
