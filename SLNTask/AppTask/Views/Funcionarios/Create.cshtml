@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Nova Funcionário";
}

<h1 class="mb-4">Cadastrar Nova Funcionário</h1>

<div class="row">
    <div class="col-md-6">
        <form action="/Funcionarios/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="Nome" class="form-label font-weight-bold">Nome</label>
                <input type="text" id="Nome" name="Nome" class="form-control" placeholder="Digite a nome do Funcionário" required />
            </div>

            <div class="mb-3">
                <label for="Cargo" class="form-label font-weight-bold">Cargo</label>
                <input type="text" id="Cargo" name="Cargo" class="form-control" placeholder="Digite a cargo do Funcionário" required />
            </div>

            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar Funcionario</button>
                <a href="/Funcionarios/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>

